# polku-routing's own copy of hosting.htaccess, with the routing squares' type. The workflow's install-hosting puts it
# in place once (#7); a change after that is made by hand.
Options -Indexes
SetEnv no-gzip 1
SetEnv no-brotli 1
AddType application/octet-stream .rd5
AddType application/json .json

Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
Header always set Access-Control-Allow-Headers "Range, If-Match"
Header always set Access-Control-Expose-Headers "ETag, Content-Length, Content-Range, Accept-Ranges"
Header always set Cache-Control "public, max-age=31536000, immutable"
<Files "current.json">
    Header always set Cache-Control "no-cache"
</Files>
